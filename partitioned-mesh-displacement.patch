+    )
+    p.add_argument(
+        "--wheel-edge-weight",
+        type=float,
+        default=0.0,
+        help="Training loss weight for wheel interior relative-displacement error",
+    )
+    p.add_argument(
+        "--wheel-interface-weight",
+        type=float,
+        default=0.0,
+        help="Training loss weight for wheel interface relative-displacement error",
+    )
+    p.add_argument(
+        "--wheel-selection-weight",
